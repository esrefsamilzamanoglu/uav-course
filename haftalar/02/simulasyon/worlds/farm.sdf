    <model name="course_camera">
      <static>true</static>
      <pose>0 0 0.1 0 1.570796 0</pose>
      <link name="body">
        <sensor name="rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>6</update_rate>
          <topic>/course/camera/image</topic>
          <camera>
            <horizontal_fov>1.22173</horizontal_fov>
            <image>
              <width>960</width>
              <height>640</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>1200</far>
            </clip>
          </camera>
        </sensor>
